{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trip-tales-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-02",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "ApiContainer"
      }
    ]
  },
  "exports": {
    "ApiContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
